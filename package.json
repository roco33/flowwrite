{
  "name": "flowwrite",
  "version": "1.0.0-alpha.0",
  "description": "flow · 流墨 — 极致轻量的 Markdown 编辑器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "check:size": "node scripts/check-size.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@lexical/code": "^0.20.2",
    "@lexical/history": "^0.20.2",
    "@lexical/link": "^0.20.2",
    "@lexical/list": "^0.20.2",
    "@lexical/markdown": "^0.20.2",
    "@lexical/rich-text": "^0.20.2",
    "@lexical/selection": "^0.20.2",
    "@lexical/table": "^0.20.2",
    "@lexical/utils": "^0.20.2",
    "idb-keyval": "^6.2.5",
    "lexical": "^0.20.2"
  }
}
